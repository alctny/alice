#!/usr/bin/env bash

function append_path() {
  case ":$PATH:" in
  *:"$1":*) ;;
  *)
    PATH="${PATH:+$PATH:}$1"
    ;;
  esac
}

function wcw() {
  find . -type f -iname '*.md' -exec cat {} + | python3 -c 'import sys,re; s=sys.stdin.read(); print(len(re.findall(r"[\u4e00-\u9fff]|[A-Za-z]+|\d+",s)))'
}

alias cime="find . -type f | sed -n 's/.*\.//p' | sort | uniq -c | sort -nr"
alias dedup='rmlint'
alias rm=gomi

if command -v xclip; then
  alias xcopy='xclip -selection clipboard'
elif command -v; then
  alias xcopy='pbcopy'
fi

