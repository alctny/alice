# 輸出歡迎 Logo
if [[ -f $HOME/.motd ]] && command -v lolcat >/dev/null 2>&1; then
  width=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
  cat $HOME/.motd | while read line; do
    padding=$(((width - ${#line}) / 2))
    ((padding < 0)) && padding=0
    printf '%*s%s\n' "$padding" '' "$line" | lolcat
  done
fi
